# ── Option A: OpenAI (needs paid balance — vision model) ──
RUN_AI_FALLBACK=1
OPENAI_API_KEY=sk-your-key-here
AI_FALLBACK_MODEL=gpt-4o
# AI_FALLBACK_BASE_URL=https://api.openai.com/v1

# ── Option B: OpenRouter (OpenAI-compatible; some free/cheap vision models) ──
# Sign up: https://openrouter.ai — add credits or use free-tier models
# RUN_AI_FALLBACK=1
# OPENAI_API_KEY=sk-or-v1-your-openrouter-key
# AI_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# AI_FALLBACK_MODEL=google/gemini-2.0-flash-001

# ── Option C: Ollama (free, local — install https://ollama.com) ──
# ollama pull llava
# RUN_AI_FALLBACK=1
# OPENAI_API_KEY=ollama
# AI_FALLBACK_BASE_URL=http://localhost:11434/v1
# AI_FALLBACK_MODEL=llava

# ── Option D: No AI (Playwright only; set when balance is $0) ──
# RUN_AI_FALLBACK=0

# AI_FALLBACK_MAX_TURNS=12
# AI_FALLBACK_QUEUE=ai_fallback_queue.jsonl

# External dashboard CORS (default *). Set to their site origin in production:
# CORS_ORIGIN=https://their-dashboard.example.com
# PORT=3050

# Production (no visible browser — default when NODE_ENV=production):
# NODE_ENV=production
# PLAYWRIGHT_HEADLESS=1
# MAX_CONCURRENT_RUNS=3

# Local dev with visible browser:
# PLAYWRIGHT_HEADED=1

# Saudi proxy — needed for Saudi government portals (geo-blocked outside KSA)
# Format: http://username:password@host:port  — leave empty if not using
SAUDI_PROXY=
